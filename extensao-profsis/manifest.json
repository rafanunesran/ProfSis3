{
  "manifest_version": 3,
  "name": "Assistente SisProf - Consulta de Aulas",
  "version": "4.0.2",
  "update_url": "https://rafanunesran.github.io/ProfSis3/extensao-profsis/dist/update.xml",
  "key": "",
  "description": "Assistente de consulta para a Sala do Futuro: mostra as aulas do dia do ProfSis, a lista de estudantes faltosos de cada turma e o conteúdo do registro salvo no ProfSis para copiar e colar. Somente leitura — não preenche Chamada/Registro nem extrai dados automaticamente.",
  "permissions": [
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://saladofuturoprofessor.educacao.sp.gov.br/*",
    "https://saladofuturo.educacao.sp.gov.br/*",
    "https://*.educacao.sp.gov.br/*",
    "*://localhost/*",
    "*://127.0.0.1/*",
    "https://*.firebaseapp.com/*",
    "https://*.profsis3.com/*",
    "https://*.web.app/*",
    "https://*.github.io/*",
    "https://securetoken.googleapis.com/*",
    "https://firestore.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://localhost/*", "*://127.0.0.1/*", "https://*.firebaseapp.com/*", "https://*.profsis3.com/*", "https://*.web.app/*", "https://*.github.io/*"],
      "js": ["content_profsis.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://saladofuturoprofessor.educacao.sp.gov.br/*",
        "https://saladofuturo.educacao.sp.gov.br/*"
      ],
      "js": ["content_sed.js"],
      "run_at": "document_idle"
    }
  ]
}