rules_version = '2';

// ============================================================================
//  REGRAS DE SEGURANÇA DO FIRESTORE — SisProf / ProfSis3
// ----------------------------------------------------------------------------
//  Como usar:
//    1. Console do Firebase > Firestore Database > aba "Regras".
//    2. Apague o conteúdo atual e cole TODO este arquivo.
//    3. Clique em "Publicar".
//    4. Entre uma vez como Admin (rafael@adm / senha) para que o app crie a
//       sessão do super_admin no Firebase Auth (necessária para as regras).
//
//  O QUE ESTAS REGRAS GARANTEM
//    - Banco fechado por padrão (deny by default).
//    - Tudo exige login (Firebase Auth), exceto o mínimo necessário para as
//      telas públicas (lista de escolas no Cadastro e relatórios de link
//      compartilhado).
//    - Perfil NOVO só acessa os dados da escola depois que o gestor liberar:
//      o controle fica no documento access/{uid} (approved true/false).
//    - Ninguém consegue LIBERAR o próprio acesso (anti-elevação): o dono do
//      access/{uid} nunca altera o próprio "approved"; só outro usuário (o
//      gestor, pela tela de controle) ou o super_admin pode liberar.
//    - Usuários antigos (sem access/{uid}) continuam funcionando (compat.),
//      para não travar quem já usava o sistema.
//
//  MODELO DE CONFIANÇA (app 100% no cliente)
//    A raiz de confiança é o super_admin, reconhecido pelo e-mail verificado do
//    token do Firebase Auth. Ele autentica no Auth ao entrar (ver core.js) e tem
//    poderes totais no banco. Gestores e professores autenticam por e-mail/senha.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------- Funções ------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    // Super admin: e-mail verificado do token. Mantenha igual ao ADMIN_EMAIL do core.js.
    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'rafael@adm.com';
    }

    function myAccessRef() {
      return /databases/$(database)/documents/access/$(request.auth.uid);
    }
    function myAccessExists() {
      return isSignedIn() && exists(myAccessRef());
    }

    // Liberado para acessar os dados da escola:
    //   - super_admin, OU
    //   - usuário antigo sem documento access/{uid} (compatibilidade), OU
    //   - documento access/{uid} com approved == true.
    function isApprovedForData() {
      return isSignedIn() && (
        isSuperAdmin()
        || !myAccessExists()
        || get(myAccessRef()).data.approved == true
      );
    }

    // ---------------------- access/{uid}: liberação --------------------------
    // Documento por usuário que controla a liberação. Regras:
    //   - Ler: o próprio dono, o gestor ou o super_admin.
    //   - Criar: o próprio dono SOMENTE como pendente (approved == false),
    //            outro usuário logado (o gestor, via tela), ou o super_admin.
    //   - Atualizar/Apagar: super_admin ou QUALQUER outro usuário logado que
    //            NÃO seja o próprio dono. Isso impede a auto-liberação: o dono
    //            nunca muda o próprio "approved". A tela de controle só expõe a
    //            ação de liberar/recusar para o gestor.
    match /access/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow create: if isSuperAdmin()
                    || (request.auth.uid == uid && request.resource.data.approved == false)
                    || (isSignedIn() && request.auth.uid != uid);
      allow update, delete: if isSuperAdmin()
                    || (isSignedIn() && request.auth.uid != uid);
    }

    // --------------------------- system/* ------------------------------------
    // schools_list: leitura pública (a tela de Cadastro monta o seletor de
    // escola antes do login). Escrita exige login (admin/gestor autenticados).
    match /system/schools_list {
      allow read: if true;
      allow write: if isSignedIn();
    }
    // users_list, backups e demais docs de sistema: apenas usuários logados.
    // (O cadastro grava aqui logo após criar a conta no Auth; login/onAuth leem
    //  para localizar o perfil.)
    match /system/{docId} {
      allow read, write: if isSignedIn();
    }

    // ------------------- shared_views: link compartilhado --------------------
    // Relatório de link público (?share=ID) é aberto por visitantes anônimos e
    // é auto-contido (não lê outras coleções). Leitura pública; escrita só por
    // quem já está liberado (o gestor gera o link).
    match /shared_views/{docId} {
      allow read: if true;
      allow write: if isApprovedForData();
    }

    // ------------------- Dados da escola e ferramentas -----------------------
    // Exigem perfil liberado (approved) — é aqui que o reforço de segurança
    // trava os perfis novos até a confirmação do gestor.
    match /app_data/{docId} {
      allow read, write: if isApprovedForData();
    }
    match /shared_attendance/{docId} {
      allow read, write: if isApprovedForData();
    }
    match /shared_material_digital/{docId} {
      allow read, write: if isApprovedForData();
    }
    match /materiais_apoio/{docId} {
      allow read, write: if isApprovedForData();
    }
    match /curriculo_chunks_embeddings/{docId} {
      allow read, write: if isApprovedForData();
    }
    match /curriculo_escopo_sequencia/{docId} {
      allow read, write: if isApprovedForData();
    }
    match /curriculo_ingest_manifest/{docId} {
      allow read, write: if isApprovedForData();
    }

    // --------------------- Padrão: nega o resto ------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
