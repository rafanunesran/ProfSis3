rules_version = '2';

// ============================================================================
//  REGRAS DE SEGURANÇA DO FIRESTORE — SisProf / ProfSis3
// ----------------------------------------------------------------------------
//  COMO USAR
//    1. Console do Firebase > Firestore Database > aba "Regras".
//    2. Apague tudo, cole este arquivo inteiro e clique em "Publicar".
//
//  PRINCÍPIO DE OURO DESTAS REGRAS: NUNCA TRANCAR QUEM JÁ USA O SISTEMA.
//    Quem não tem documento em `access/<uid>` (todos os usuários antigos) é
//    tratado como JÁ LIBERADO. Só quem tem o documento com approved == false
//    (ou seja, cadastros novos, criados pelo próprio app) fica bloqueado.
//    Consequência: é impossível estas regras trancarem um professor antigo.
//
//  QUEM PODE LIBERAR UM PERFIL NOVO
//    - o super_admin (identificado pelo e-mail do token), ou
//    - um usuário cujo access/<uid> diga approved == true E role == 'gestor', ou
//    - um usuário antigo (sem documento de acesso) — equipe já existente.
//    Um cadastro NOVO sempre tem documento com approved:false e role:'professor',
//    portanto NÃO consegue liberar ninguém, nem a si mesmo. Além disso, ninguém
//    altera o próprio documento de acesso (anti-elevação explícita).
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------- Funções ----------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    // Super admin: e-mail do token do Firebase Auth.
    // Precisa ser IGUAL ao ADMIN_EMAIL definido no core.js.
    // Para adicionar outro administrador, inclua o e-mail nesta lista.
    function isSuperAdmin() {
      return isSignedIn()
             && request.auth.token.email in ['rafaelnf93@gmail.com', 'rafael@adm.com']
             // A conta definitiva só vale com o e-mail verificado. A ordem importa:
             // para quem não está na lista acima, o curto-circuito impede que esta
             // linha seja avaliada — nenhum professor comum depende dela.
             && (request.auth.token.email != 'rafaelnf93@gmail.com'
                 || request.auth.token.email_verified == true);
    }

    // Depois de 07/09/2026 às 07:00 de São Paulo (10:00 UTC), dado pessoal de
    // estudante não entra mais em app_data. É esta regra que faz o corte valer:
    // a verificação no aplicativo é só experiência de uso.
    function depoisDoCorte() {
      return request.time > timestamp.date(2026, 9, 7) + duration.value(10, 'h');
    }

    // Espelha CAMPOS_PESSOAIS de shared.js. Ao acrescentar um campo pessoal lá,
    // acrescente aqui também.
    function semCamposPessoais() {
      return !request.resource.data.keys().hasAny([
        'estudantes', 'presencas', 'atrasos', 'trabalhos', 'notas', 'compensacoes',
        'tutorados', 'encontros', 'agendamentos', 'ocorrencias',
        'registrosAdministrativos', 'caderno', 'baixaFrequencia',
        'notasAvaliacoesGestor', 'notasBimestraisOficiais', 'lotesMapaoGestor'
      ]);
    }

    function accessPath() {
      return /databases/$(database)/documents/access/$(request.auth.uid);
    }

    // Usuário ANTIGO: não possui documento de acesso. Tratado como liberado.
    function semDocAcesso() {
      return isSignedIn() && !exists(accessPath());
    }

    function meuAcesso() {
      return get(accessPath()).data;
    }

    // Pode usar os dados da escola?
    // super_admin  OU  usuário antigo (sem doc)  OU  doc com approved == true.
    // O operador || tem curto-circuito: get() só roda se o doc existir.
    // Quem pode usar os dados da escola?
    //
    // ATE 07/09/2026 esta funcao exigia access/<uid> com approved == true, e quem
    // tivesse o documento marcado approved:false ficava bloqueado. O problema: o
    // cadastro do app cria esse documento com approved:false para TODO mundo, e se
    // a gestao nunca confirmou o perfil, a pessoa e' trancada no instante em que
    // estas Regras entram no ar - mesmo usando o sistema ha' meses. Foi o que
    // aconteceu ao publicar: professores com conta valida pararam de entrar.
    //
    // O portao de aprovacao continua existindo, mas onde ele nao tranca ninguem
    // fora: no aplicativo (renderTelaAguardandoAprovacao, em app.js). Aqui, quem
    // esta autenticado passa. E' o "PRINCIPIO DE OURO" escrito no topo deste
    // arquivo, agora valendo de verdade.
    //
    // O que estas Regras protegem nao e' quem entra - e' o que sai: dado pessoal
    // de estudante nao entra em app_data depois do corte, e nome de estudante nao
    // vai para o link publico. Essa parte segue intacta.
    function liberado() {
      return isSignedIn();
    }

    // Conta que o super admin marcou para seguir 100% online. O campo mora em
    // access/<uid> e só o super admin escreve nele (ver o bloco de access abaixo),
    // então isto não é uma porta que o próprio usuário consegue abrir.
    function isentoDoCorte() {
      return isSignedIn() && !semDocAcesso()
             && meuAcesso().get('modoOnlineCompleto', false) == true;
    }

    // Pode LIBERAR/RECUSAR o acesso de outra pessoa?
    // super_admin, gestor já liberado, ou usuário antigo (equipe existente).
    // Um cadastro novo (approved:false) nunca satisfaz nenhuma das condições.
    function podeAprovar() {
      return isSuperAdmin()
             || semDocAcesso()
             || (isSignedIn() && meuAcesso().approved == true && meuAcesso().role == 'gestor');
    }

    // ------------------- access/<uid>: controle de liberação -----------------
    match /access/{uid} {
      // Lê o próprio status; gestor/admin leem para administrar.
      allow read: if isSignedIn() && (request.auth.uid == uid || podeAprovar());

      // O próprio usuário cria o SEU documento em dois casos:
      //   1) PENDENTE - o cadastro antigo, que espera o gestor liberar;
      //   2) LIBERADO - quando declara um espaço que EXISTE (Fase 3). O código de
      //      convite é o portão, e quem não tem o código não descobre o espacoId:
      //      ele é um UUID, `list` está negado em /espacos e o índice do código só
      //      pode ser lido por quem sabe o código para calcular o endereço.
      // Gestor/admin podem criar o documento de outra pessoa.
      // Campos que SO' o super admin concede. Sem esta trava, bastava o proprio
      // usuario incluir <modoOnlineCompleto: true> no documento que ele mesmo cria no
      // cadastro para se isentar do corte - e a isencao autoriza gravar dado pessoal
      // em claro. O bloqueio de alteracao ja' existia; o de CRIACAO faltava.
      allow create: if ((request.auth.uid == uid
                        && !request.resource.data.keys().hasAny(['modoOnlineCompleto', 'limiteTerminais'])
                        && (
                             (request.resource.data.approved == false
                              && request.resource.data.role == 'professor')
                          || (request.resource.data.approved == true
                              && request.resource.data.espacoId is string
                              && exists(/databases/$(database)/documents/espacos/$(request.resource.data.espacoId)))
                        ))
                    || (podeAprovar() && request.auth.uid != uid)
                    || isSuperAdmin());

      // ANTI-ELEVAÇÃO: ninguém altera o próprio documento de acesso.
      allow update, delete: if isSuperAdmin()
                            || (podeAprovar() && request.auth.uid != uid);
    }

    // ----------------------------- terminais/* -------------------------------
    // [FASE 7] Quantas telas podem ver a conta ao mesmo tempo. O limite mora em
    // access/<uid>.limiteTerminais (ausente = 1, zero = ilimitado) e SO' o super
    // admin escreve, como o modoOnlineCompleto.
    //
    // Este documento aqui e' so' a lista de quem esta' ocupando as vagas, e o dono
    // escreve nela de proposito: e' assim que ele assume a vaga ao trocar de maquina.
    // Registro honesto: isto e' REGRA DE USO, nao barreira de seguranca - o dono da
    // conta tem a senha e a chave, e quem quiser burlar o limite consegue. Serve
    // contra o descuido e o compartilhamento casual.
    match /terminais/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow write: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
    }

    // ---------------------- espacos/* e espacos_indice/* ---------------------
    // [FASE 3] A escola vira um ESPACO com codigo de convite.
    //
    //  espacos_indice/<sha256("profsis-v1:" + codigo)> -> < espacoId >
    //  espacos/<uuid>                                  -> nome, timbre, salt, legacySchoolId
    //
    // LEITURA SEM SESSAO, DE PROPOSITO - e' a mesma licao de system/users_list:
    // o codigo e' conferido na tela de CADASTRO, antes de existir qualquer sessao.
    // Exigir isSignedIn() aqui trancaria todo mundo do lado de fora, de novo. E nao
    // ha o que proteger com sessao: quem nao tem o codigo nao consegue nem calcular
    // o endereco do indice, e o espacoId e' um UUID.
    //
    // `list` NEGADO nas duas colecoes: e' o que impede alguem de varrer o banco
    // atras dos espacos dos outros. Sem list, o id so' chega a quem tem o codigo.
    //
    // O codigo em si NAO esta aqui - nem hasheado com salt fixo seria seguro contra
    // forca bruta se o alfabeto fosse pequeno. Ele so' existe no aparelho de quem
    // entrou, e e' dele que a Fase 4 vai derivar a chave da camada cifrada.
    match /espacos/{espacoId} {
      allow get: if true;
      allow list: if isSuperAdmin();
      allow create: if isSignedIn();
      allow update: if isSuperAdmin()
                    || (isSignedIn() && !semDocAcesso()
                        && meuAcesso().espacoId == espacoId
                        && meuAcesso().role == 'gestor');
      allow delete: if isSuperAdmin();
    }

    match /espacos_indice/{codigoHash} {
      allow get: if true;
      allow list: if isSuperAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    // ------------------------------ system/* ---------------------------------
    // ---------------------------- system/* -----------------------------------
    // LEITURA PÚBLICA, DE PROPÓSITO. Nao mexer aqui.
    //
    // O login do SisProf tem um caminho legado: quando o Firebase Auth recusa a
    // credencial, o app compara a senha guardada em system/users_list. Esse
    // caminho roda ANTES de existir sessao, entao qualquer regra que exija
    // autenticacao para ler este documento tranca do lado de fora todo professor
    // cuja senha no Auth nao coincide com a da lista - e havia varios.
    //
    // Foi exatamente o que aconteceu em 07/09/2026: uma versao destas Regras
    // exigiu isSignedIn() aqui, e professores com conta valida pararam de entrar.
    //
    // Estas Regras existem para a adequacao da SEDUC, que trata de DADO DE
    // ESTUDANTE. Nao ha dado de estudante em system/*. Endurecer esta colecao nao
    // atende a nenhuma exigencia da Secretaria e so' cria risco de bloqueio.
    //
    // O problema real deste documento - senha em texto claro - nao se resolve com
    // Regra, e sim apagando o campo: painel do Super Admin, "Sincronizar UIDs e
    // Remover Senhas". Feito isso, o caminho legado deixa de existir sozinho e
    // esta abertura pode ser fechada com seguranca.
    match /system/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ------------------ shared_views: relatório por link ---------------------
    // O link público (?share=ID) é aberto por visitantes sem login.
    // O link público (?share=ID) é aberto SEM LOGIN: tudo aqui está na internet.
    // Até setembro/2026 o payload trazia a lista de estudantes com nome completo.
    match /shared_views/{docId} {
      allow read: if true;
      allow write: if liberado()
                   && !request.resource.data.keys().hasAny(['dados', 'estudantes']);
    }

    // Envelope da chave do backup cifrado. Não há dado pessoal aqui — só material
    // criptográfico, inútil sem a senha do professor ou a chave de suporte.
    match /chaves_backup/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // ----------------- Dados da escola: exigem perfil liberado ---------------
    // Um backup, depois de escrito, NÃO MUDA e NÃO SOME por 30 dias.
    //
    // Esta regra existe por causa de um estrago real: uma função do aplicativo varreu
    // 20 slots de backup chamando delete() em cada um, dentro de um `catch` vazio, e
    // deixou uma conta sem nenhuma cópia — enquanto 45 colegas, que não passaram por
    // aquele caminho, mantiveram as suas. Enquanto a permissão de apagar morar só no
    // código, o próximo laço distraído faz de novo.
    //
    // Aqui o banco recusa por conta própria: backup só é criado, nunca alterado, e só
    // pode ser apagado depois de 30 dias — e ainda assim apenas se carregar a marca de
    // quando nasceu. Sem a marca, não sai nunca. Nenhum bug do cliente tem como passar
    // por cima disso, porque a decisão não está mais no cliente.
    function ehBackup(docId) {
      return docId.matches('^backup_.*') && !docId.matches('^backup_index_.*');
    }
    function backupJaPodeSair() {
      return resource.data.get('criadoEmMs', 0) is number
             && resource.data.get('criadoEmMs', 0) > 0
             && request.time.toMillis() > resource.data.get('criadoEmMs', 0) + 2592000000;
    }

    match /app_data/{docId} {
      allow read: if liberado();
      allow delete: if liberado() && (!ehBackup(docId) || backupJaPodeSair());

      // Antes do corte, idêntico ao que sempre foi. Depois dele, o documento só
      // entra se não trouxer campo pessoal, ou for um backup REALMENTE cifrado
      // (o nome `backup_` sozinho não isenta), ou pertencer a uma conta que o super
      // admin marcou como isenta.
      //
      // A isenção existe no aplicativo desde a Fase 1 (modoOnlineCompleto, em
      // access/<uid>, gravável só pelo super admin) e FALTAVA aqui. A consequência
      // era silenciosa e diária: a conta isenta mandava o dado pessoal, porque o
      // aplicativo a autorizava, e o banco recusava tudo com "Missing or
      // insufficient permissions" a cada salvamento.
      allow create: if liberado() && (
           !depoisDoCorte()
        || semCamposPessoais()
        || (docId.matches('^backup_.*') && request.resource.data.get('cifrado', false) == true)
        || isentoDoCorte()
      );

      // Update segue igual para tudo, MENOS para backup: backup nasce e fica como
      // nasceu. Reescrever um backup é perder a versão que ele guardava, que é a única
      // razão de ele existir.
      allow update: if liberado() && !ehBackup(docId) && (
           !depoisDoCorte()
        || semCamposPessoais()
        || isentoDoCorte()
      );
    }
    match /shared_attendance/{docId} {
      allow read, write: if liberado();
    }
    match /shared_material_digital/{docId} {
      allow read, write: if liberado();
    }
    match /materiais_apoio/{docId} {
      allow read, write: if liberado();
    }
    match /curriculo_chunks_embeddings/{docId} {
      allow read, write: if liberado();
    }
    match /curriculo_escopo_sequencia/{docId} {
      allow read, write: if liberado();
    }
    match /curriculo_ingest_manifest/{docId} {
      allow read, write: if liberado();
    }

    // --------------------- Padrão: nega o resto ------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
